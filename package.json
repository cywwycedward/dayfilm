{
  "name": "dayfilm",
  "version": "4.0.0",
  "private": true,
  "description": "Dayfilm - 把一天剪成一部电影",
  "author": "Dayfilm",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "pack": "electron-vite build && electron-builder --dir --config electron-builder.yml",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.yml"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.2",
    "@types/node": "^22.10.2",
    "electron": "^33.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^29.1.1",
    "openai": "^7.62.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
