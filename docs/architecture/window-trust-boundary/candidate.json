  "cards": [
    {
      "dot": "cyan",
      "title": "渲染进程的硬约束",
      "items": [
        "sandbox: true、contextIsolation: true、nodeIntegration: false，两个窗口同一套 webPreferences",
        "CSP 不允许远程脚本、样式、图片与 eval；新窗口与站外导航一律拒绝",
        "两个窗口共用同一份 DayfilmApi；HUD 只用 live/onTick 渲染，另有一个 open() 用来点开主窗口"
      ]
    },
    {
      "dot": "emerald",
      "title": "IPC 的两个方向",
      "items": [
        "invoke 覆盖取数、设置、导出、标记、HUD、退出；send 只有 HUD 单击打开主窗口",
        "主进程另外推送 tick、放映切换、最大化变化三个单向通知",
        "非法入参按契约回落成空结果，不抛异常；来源不可信直接拒绝并只记通道名"
      ]
    },
    {
      "dot": "rose",
      "title": "为什么守卫在 main",
      "items": [
        "trustedOrigin 只认 devserver 与本地 index.html；打包版连回环都取消",
        "同一套判断同时管 invoke 与 send，新增通道漏加守卫会被单测抓住",
        "日志只留通道名与进程名，窗口标题不进日志"
      ]
    }
  ]
}
